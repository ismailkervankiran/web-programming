					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"const list = pm.response.json();",
							"pm.test(\"en az 6 kayıt (seed sonrası 6)\", function () {",
							"    pm.expect(list.length).to.be.at.least(6);",
							"});",
							"pm.test(\"_id, createdAt, updatedAt var\", function () {",
							"    pm.expect(list[0]).to.include.keys(\"_id\", \"createdAt\", \"updatedAt\");",
							"});",
							"// 3. istek için listeden gerçek bir _id",
							"pm.collectionVariables.set(\"eventId\", list[0]._id);"
						]
					}
				}
			],
